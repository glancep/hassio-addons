arch:
  - aarch64
  - amd64
description: Trek: A self-hosted, real-time collaborative travel planner — with maps, budgets, packing lists, a journal, and AI built in.
environment:
  NODE_ENV: production
  PORT: 3000
#  ENCRYPTION_KEY: ${ENCRYPTION_KEY:-}   # GLP_FIX: generate with: openssl rand -hex 32
#  TZ: ${TZ:-UTC}
#  LOG_LEVEL: ${LOG_LEVEL:-info}
#  ALLOWED_ORIGINS: 
#  APP_URL: ${APP_URL:-}                 # required for OIDC + email links
#  FORCE_HTTPS: true                   # behind a TLS-terminating proxy
#  TRUST_PROXY: 1
#  OIDC_ISSUER: https://auth.example.com
#  OIDC_CLIENT_ID: trek
#  OIDC_CLIENT_SECRET: supersecret
#  OIDC_DISPLAY_NAME: SSO
#  OIDC_ADMIN_CLAIM: groups
#  OIDC_ADMIN_VALUE: app-trek-admins
image: mauriceboe/trek:latest
ingress: false
map:
  - addon_config:rw
  - data:rw
  - config:rw
name: Trek
ports:
  3000/tcp: 3000
ports_description:
  3000/tcp: Web interface
options:
  env_vars: []
  Allowed_origins: ""
  App_url: ""
  Log_level: info
  TZ: America/Chicago
  PGID: 1000
  PUID: 1000
schema:
  env_vars:
    - name: match(^[A-Za-z0-9_]+$)
      value: str?
  Allowed_origins: list(str)?
  App_url: str?
  Log_level: list(critical|error|warning|info|verbose|debug|trace)?
  TZ: str?
  PGID: int
  PUID: int
slug: trek
url: https://github.com/glancep/hassio-addons/trek
version: "v0.0.1"